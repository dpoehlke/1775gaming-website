# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# Supabase (database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=

# Stripe (web membership). Start with TEST keys. See SETUP_MEMBERSHIP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe price id per plan (Basic / All-Access × monthly / annual).
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_ALLACCESS_MONTHLY=
STRIPE_PRICE_ALLACCESS_ANNUAL=

# RevenueCat (mobile — App Store/Play). See DEPLOY_MONETIZATION.md.
# REVENUECAT_WEBHOOK_AUTH = the Authorization header value you set on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=
# Entitlement ids that map a mobile purchase to a membership tier...
REVENUECAT_BASIC_ENTITLEMENT=
REVENUECAT_ALLACCESS_ENTITLEMENT=
# ...and premium games: comma list of entitlementId:gameSlug (e.g. omni_sub:omniverse,deso_sub:desolation)
REVENUECAT_PREMIUM_ENTITLEMENTS=

# Admin auth
# Generate ADMIN_PASSWORD_HASH by running: node scripts/hash-admin-password.mjs
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_UID=

# Omniverse game project (server-side only)
OMNIVERSE_SUPABASE_URL=
NEXT_PUBLIC_OMNIVERSE_SUPABASE_URL=
OMNIVERSE_ANON_KEY=
OMNIVERSE_SERVICE_ROLE_KEY=

# Site URL (used in OAuth callbacks)
NEXT_PUBLIC_SITE_URL=
