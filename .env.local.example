# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# Supabase (database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=

# Stripe (1775 membership billing — web). Start with TEST keys. See SETUP_MEMBERSHIP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PRICE_ID=

# RevenueCat (1775 membership billing — mobile, App Store/Play). See DEPLOY_MONETIZATION.md.
# REVENUECAT_WEBHOOK_AUTH = the Authorization header value you set on the RevenueCat webhook.
# REVENUECAT_MEMBERSHIP_ENTITLEMENT = the RC entitlement id that represents the 1775 membership.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_MEMBERSHIP_ENTITLEMENT=

# Admin auth
# Generate ADMIN_PASSWORD_HASH by running: node scripts/hash-admin-password.mjs
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_UID=

# Omniverse game project (server-side only)
OMNIVERSE_SUPABASE_URL=
NEXT_PUBLIC_OMNIVERSE_SUPABASE_URL=
OMNIVERSE_ANON_KEY=
OMNIVERSE_SERVICE_ROLE_KEY=

# Site URL (used in OAuth callbacks)
NEXT_PUBLIC_SITE_URL=
